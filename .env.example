# Meeting Phantom Ultra - Environment Variables Template
# REQUIRED: All variables below must be set for the application to work
# OPTIONAL: Variables marked as such can be omitted in development
#
# Setup Instructions:
# 1. Copy this file to .env.local: cp .env.example .env.local
# 2. Fill in all REQUIRED variables with your actual API keys
# 3. Run database sync: npm run db:push
# 4. Start development server: npm run dev
#
# See .env.production.example for production-specific configuration

# =============================================================================
# DATABASE (Supabase) - REQUIRED
# =============================================================================
# Get these from your Supabase project: https://app.supabase.com/project/_/settings/database
# Free Tier: 500MB database, 2GB bandwidth, 50MB file storage
# Note: DATABASE_URL uses pgbouncer for connection pooling (required for Vercel)
DATABASE_URL="postgresql://username:password@hostname:port/database?pgbouncer=true"
DIRECT_URL="postgresql://username:password@hostname:port/database"

# =============================================================================
# AUTHENTICATION (Clerk) - REQUIRED
# =============================================================================
# Get these from Clerk dashboard: https://dashboard.clerk.com
# Free Tier: 10,000 monthly active users, unlimited applications
# Note: Use pk_test_* keys for development, pk_live_* for production
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# =============================================================================
# ZOOM INTEGRATION - REQUIRED
# =============================================================================
# Create a Zoom OAuth app: https://marketplace.zoom.us/develop/create
# Free Tier: Basic plan sufficient for OAuth integration
# Required OAuth scopes: meeting:read, meeting:write, user:read
# Important: Set redirect URI to http://localhost:3000/api/auth/zoom/callback (dev)
ZOOM_CLIENT_ID="your_zoom_client_id"
ZOOM_CLIENT_SECRET="your_zoom_client_secret"
ZOOM_WEBHOOK_SECRET="your_zoom_webhook_secret"
ZOOM_REDIRECT_URI="http://localhost:3000/api/auth/zoom/callback"

# =============================================================================
# ASSEMBLYAI (Transcription) - REQUIRED
# =============================================================================
# Get API key from AssemblyAI dashboard: https://www.assemblyai.com/dashboard
# Free Tier: 5 hours of transcription per month
# Paid Tier: $0.15-0.25 per audio hour depending on features
ASSEMBLYAI_API_KEY="your_assemblyai_api_key"

# =============================================================================
# GMAIL INTEGRATION - REQUIRED
# =============================================================================
# Create OAuth credentials: https://console.cloud.google.com/apis/credentials
# Free Tier: Gmail API is free with rate limits (250 quota units per user per second)
# Required OAuth scopes: https://www.googleapis.com/auth/gmail.send
# Important: Set redirect URI to http://localhost:3000/api/auth/gmail/callback (dev)
GMAIL_CLIENT_ID="your_gmail_client_id"
GMAIL_CLIENT_SECRET="your_gmail_client_secret"
GMAIL_REDIRECT_URI="http://localhost:3000/api/auth/gmail/callback"

# =============================================================================
# OPENAI (AI Processing) - REQUIRED
# =============================================================================
# Get API key from OpenAI platform: https://platform.openai.com/api-keys
# Paid Tier Only: GPT-4 requires paid account (~$0.03 per 1K tokens)
# Note: GPT-3.5-turbo is cheaper alternative (~$0.002 per 1K tokens)
OPENAI_API_KEY="sk-your_openai_api_key"

# =============================================================================
# SECURITY - REQUIRED
# =============================================================================
# Generate secure random strings with: openssl rand -base64 32
# These secrets must be at least 32 characters long
NEXTAUTH_SECRET="your_nextauth_secret_minimum_32_characters"

# Vercel Cron Job authentication (production only, can be empty in development)
# Generate with: openssl rand -base64 32
CRON_SECRET="your_cron_secret_for_vercel_minimum_32_characters"

# =============================================================================
# DEVELOPMENT
# =============================================================================
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# =============================================================================
# OPTIONAL: MONITORING & DEBUGGING
# =============================================================================
# Uncomment these for enhanced logging during development
# NEXT_PUBLIC_LOG_LEVEL="debug"
# PRISMA_LOG_LEVEL="info,warn,error"

# =============================================================================
# OPTIONAL: EXTERNAL MONITORING (Production)
# =============================================================================
# Uncomment and configure if using external monitoring services
# SENTRY_DSN="https://your-sentry-dsn@sentry.io/project-id"
# VERCEL_ENV="production"

# =============================================================================
# SETUP CHECKLIST
# =============================================================================
# □ Copy this file to .env.local
# □ Create Supabase project and add DATABASE_URL + DIRECT_URL
# □ Create Clerk application and add NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY + CLERK_SECRET_KEY
# □ Create Zoom OAuth app and add ZOOM_CLIENT_ID + ZOOM_CLIENT_SECRET + ZOOM_WEBHOOK_SECRET
# □ Get AssemblyAI API key and add ASSEMBLYAI_API_KEY
# □ Create Google Cloud OAuth credentials and add GMAIL_CLIENT_ID + GMAIL_CLIENT_SECRET
# □ Get OpenAI API key and add OPENAI_API_KEY
# □ Generate NEXTAUTH_SECRET with: openssl rand -base64 32
# □ Generate CRON_SECRET with: openssl rand -base64 32 (production only)
# □ Run database sync: npm run db:push
# □ Start development server: npm run dev
# □ Test authentication flow at http://localhost:3000

# =============================================================================
