# Meeting Phantom Ultra - Production Environment Variables
# For Vercel deployment - set these in Vercel Dashboard > Settings > Environment Variables

# =============================================================================
# DATABASE (Supabase Production)
# =============================================================================
DATABASE_URL="postgresql://username:password@hostname:port/database?pgbouncer=true"
DIRECT_URL="postgresql://username:password@hostname:port/database"

# =============================================================================
# AUTHENTICATION (Clerk Production)
# =============================================================================
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_live_..."
CLERK_SECRET_KEY="sk_live_..."

# =============================================================================
# ZOOM INTEGRATION (Production App)
# =============================================================================
ZOOM_CLIENT_ID="production_zoom_client_id"
ZOOM_CLIENT_SECRET="production_zoom_client_secret"
ZOOM_WEBHOOK_SECRET="production_zoom_webhook_secret"
ZOOM_REDIRECT_URI="https://yourdomain.com/api/auth/zoom/callback"

# =============================================================================
# ASSEMBLYAI (Production)
# =============================================================================
ASSEMBLYAI_API_KEY="production_assemblyai_api_key"

# =============================================================================
# GMAIL INTEGRATION (Production OAuth)
# =============================================================================
GMAIL_CLIENT_ID="production_gmail_client_id"
GMAIL_CLIENT_SECRET="production_gmail_client_secret"
GMAIL_REDIRECT_URI="https://yourdomain.com/api/auth/gmail/callback"

# =============================================================================
# OPENAI (Production)
# =============================================================================
OPENAI_API_KEY="sk-production_openai_api_key"

# =============================================================================
# SECURITY (Production)
# =============================================================================
NEXTAUTH_SECRET="production_secret_minimum_32_characters_very_secure"
CRON_SECRET="production_cron_secret_for_vercel_authentication"

# =============================================================================
# PRODUCTION CONFIG
# =============================================================================
NODE_ENV="production"
NEXT_PUBLIC_APP_URL="https://yourdomain.com"

# =============================================================================
# MONITORING & LOGGING (Optional)
# =============================================================================
# SENTRY_DSN="https://your-sentry-dsn"
# VERCEL_ENV="production"
